{
  "name": "flowpal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm dev:app & sleep 3 && pnpm dev:desktop",
    "dev:server": "tsx watch packages/server/src/main.ts",
    "dev:app": "pnpm --filter @flowpal/app dev",
    "dev:mock": "pnpm --filter @flowpal/app dev:mock",
    "dev:mock:desktop": "VITE_MOCK=1 pnpm dev:app & sleep 3 && FLOWPAL_MOCK=1 pnpm dev:desktop",
    "dev:desktop": "pnpm --filter @flowpal/electron dev",
    "dev:electron": "pnpm --filter @flowpal/electron dev",
    "build:electron": "pnpm --filter @flowpal/electron build",
    "dev:desktop:legacy": "pnpm --filter @flowpal/desktop dev",
    "check:fixtures": "pnpm --filter @flowpal/server check:fixtures",
    "bench:now": "pnpm --filter @flowpal/server bench:now",
    "check:tokens": "pnpm --filter @flowpal/app check:tokens",
    "check:markup": "pnpm --filter @flowpal/shared check:markup",
    "check": "pnpm typecheck && pnpm check:tokens && pnpm check:markup && pnpm check:fixtures",
    "demo:reset": "pnpm --filter @flowpal/server demo:reset",
    "test:sync": "pnpm --filter @flowpal/server test:sync",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
